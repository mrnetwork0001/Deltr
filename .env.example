# ─────────────────────────────────────────────────────────────────────────────
# Deltr — environment template.  Copy to `.env`.  EVERYTHING is optional:
# `python main.py` with no `.env` runs PAPER mode on real mainnet market data.
# Market DATA is real Binance mainnet in every mode (keyless, read-only).
# LIVE mode exists and places REAL orders with REAL money.  It is opt-in six times
# over and refuses to start unless every part below is set; nothing arms by default.
# ─────────────────────────────────────────────────────────────────────────────

# Run mode: paper (default: zero secrets, simulated fills on real mainnet prices)
#           testnet (real Binance USDⓈ-M Futures TESTNET orders; needs keys below)
#           live    (REAL MONEY: real mainnet perp orders + a real on-chain leg signed
#                    by the Binance Agentic Wallet.  See the LIVE block near the bottom.)
DELTR_MODE=paper
DELTR_SYMBOLS=BNBUSDT
DELTR_CAPITAL_USD=10000
DELTR_MIN_EDGE_BPS=3
DELTR_DEFAULT_LEVERAGE=2
DELTR_FUNDING_HORIZON_HOURS=72
DELTR_LEG_ORDER=dex_first
DELTR_AUTO_EXECUTE=false

# Binance credentials — same variable names as Binance Agent OS / binance-cli.
# Get TESTNET keys at https://testnet.binancefuture.com (login with GitHub).
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# testnet | demo | mainnet   ("prod" is refused in every mode; mainnet trading is
# spelled BINANCE_API_ENV=mainnet and additionally needs DELTR_MODE=live + DELTR_LIVE_ACK)
BINANCE_API_ENV=testnet

# Binance MCP Server (Agent OS) — hosted, OAuth via a supported client.
# Deltr's bridge discovers its tools at runtime and falls back to the local shim.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_MCP_TOKEN=

# BNB Smart Chain — PancakeSwap V3 quotes are read from mainnet (public RPC, no key, read-only).
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_RPC_FALLBACKS=https://bsc-dataseed1.bnbchain.org/,https://bsc-rpc.publicnode.com/

# Safety thresholds (bps) — the 3x / 2% / 3% invariants are hard-coded and cannot be loosened.
DELTR_PRICE_SANITY_BPS=100
DELTR_PRICE_DRIFT_BPS=20

# Ports / state
DELTR_API_PORT=8000
DELTR_BRIDGE_PORT=8788
DELTR_STATE_DIR=./state
# Deterministic replay of a recorded fixture (REPLAY badge shown in the UI)
# DELTR_REPLAY_PATH=tests/fixtures/replay.jsonl

# ---------------------------------------------------------------------------
# On-chain leg: the Binance Agentic Wallet CLI (`baw`)
# ---------------------------------------------------------------------------
# Deltr NEVER holds, reads, stores or signs with a private key. The Binance
# Agentic Wallet custodies the key, enforces its own daily spending limits and
# performs the signing; Deltr shells out to the CLI and reads its JSON. There is
# no private-key variable here and there never will be one.
#
# Sign in once, out of band:   baw auth signin --json
#                              baw auth verify --qrCodeId <id> --json
DELTR_BAW_BIN=baw
DELTR_BAW_TIMEOUT_S=25
DELTR_BAW_SWAP_TIMEOUT_S=150
DELTR_BAW_CONFIRM_TIMEOUT_S=180
DELTR_WALLET_CHAIN_ID=56

# The value-moving on-chain path is opt-in THREE times over:
#   1. select it here (default "off" — no on-chain value can move while it is),
#   2. have a signed-in wallet session (checked against the CLI at call time),
#   3. set the acknowledgement below, verbatim.
# Every tool that moves value ALSO requires confirm=true on the call itself.
DELTR_ONCHAIN_MODE=off
# DELTR_ONCHAIN_ACK=i-understand-this-moves-real-funds

# Deltr's own ceilings, deliberately small. Binance's wallet limits apply on top.
DELTR_ONCHAIN_MAX_NOTIONAL_USD=250
DELTR_ONCHAIN_MAX_AGGREGATE_USD=1000
DELTR_ONCHAIN_MAX_SLIPPAGE_PCT=0.5
DELTR_ONCHAIN_MAX_PRICE_IMPACT_PCT=1.0

# ---------------------------------------------------------------------------
# x402 (B402) payments on BNB Smart Chain
# ---------------------------------------------------------------------------
# BUYER: ceiling per payment, applied before the wallet is asked to sign.
DELTR_X402_MAX_PAYMENT_UNITS=1.0
# SELLER: the address that would receive payment for the edge report. Deltr never
# derives or invents one, and refuses to build a challenge without it.
# DELTR_X402_PAY_TO=
DELTR_X402_PRICE_UNITS=0.05

# ─────────────────────────────────────────────────────────────────────────────
# LIVE MODE — REAL MONEY.  Every line below has to be set on purpose.
# Deltr refuses to start if any one is missing and tells you which.
# ─────────────────────────────────────────────────────────────────────────────
# 1. DELTR_MODE=live                    (above, or `--mode live`)
# 2. BINANCE_API_KEY / BINANCE_SECRET_KEY   real MAINNET keys (above)
# 3. BINANCE_API_ENV=mainnet            (above)
# 4. the acknowledgement below, spelled exactly
# 5. the on-chain opt-in above (DELTR_ONCHAIN_MODE=live + DELTR_ONCHAIN_ACK)
# 6. the Binance Agentic Wallet CLI installed AND signed in
#    (`baw auth signin --json`, then `baw auth verify --qrCodeId <id> --json`).
#    Deltr never signs in for you, never creates a wallet and never holds the key:
#    Binance's wallet keeps custody, applies its own limits and does the signing.
# DELTR_LIVE_ACK=i-understand-this-trades-real-money

# LIVE caps.  Small on purpose.  DELTR_LIVE_MAX_NOTIONAL_USD can only LOWER the
# $250 per-trade ceiling; the mode's table entry is a hard maximum.
DELTR_LIVE_MAX_NOTIONAL_USD=250
DELTR_LIVE_MAX_AGGREGATE_USD=1000

# Execution style for the perp leg: maker (default) posts a post-only (GTX) order and
# never crosses the spread; taker crosses with a LIMIT IOC.  Measured over 500 days of
# real mainnet funding, the round trip is about 16.6 bps taken against about 8.6 bps
# posted, and carry clears the taken cost in only 3.8% of 7-day windows on BNBUSDT.
# Choose taker deliberately or not at all.
DELTR_EXECUTION_STYLE=maker
DELTR_PERP_MAKER_FEE_BPS=2.0
DELTR_MAKER_OFFSET_TICKS=0
DELTR_MAKER_WAIT_MS=8000
DELTR_MAKER_POLL_MS=400
DELTR_MAKER_REPRICE_ATTEMPTS=3
